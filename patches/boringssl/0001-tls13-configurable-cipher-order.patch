+int SSL_set_tls13_cipher_prefs(SSL *ssl, const char *str) {
+  auto *ssl_impl = FromOpaque(ssl);
+  if (!ssl_impl->config) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_SHOULD_NOT_HAVE_BEEN_CALLED);
+    return 0;
+  }
+  if (str == nullptr) {
+    str = "";
+  }
+
+  // Resolve a cipher name (given as a [name, name + len) slice) to the wire ID
+  // of a TLS 1.3 cipher suite, or 0 if the token does not name one. This reuses
+  // BoringSSL's own cipher table so no cipher names or IDs are hard-coded here.
+  auto tls13_id = [](const char *name, size_t len) -> uint16_t {
+    for (const SSL_CIPHER &cipher : AllCiphers()) {
+      if (SSL_CIPHER_get_min_version(&cipher) == TLS1_3_VERSION &&
+          strlen(cipher.name) == len &&
+          OPENSSL_strncasecmp(cipher.name, name, len) == 0) {
+        return SSL_CIPHER_get_protocol_id(&cipher);
+      }
+    }
+    return 0;
+  };
+
+  // Walk the ':'-separated list and collect, in order, the wire IDs of the
+  // TLS 1.3 ciphers it names. There are only a handful of TLS 1.3 ciphers, so a
+  // small fixed buffer is more than enough.
+  uint16_t ids[16];
+  size_t num = 0;
+  for (const char *p = str; *p != '\0' && num < sizeof(ids) / sizeof(ids[0]);) {
+    const char *start = p;
+    while (*p != '\0' && *p != ':') {
+      p++;
+    }
+    uint16_t id = tls13_id(start, static_cast<size_t>(p - start));
+    if (id != 0) {
+      ids[num++] = id;
+    }
+    if (*p == ':') {
+      p++;
+    }
+  }
+
+  // An empty result clears any override and restores the default ordering.
+  return ssl_impl->config->tls13_cipher_ids.CopyFrom(Span(ids, num));
+}
