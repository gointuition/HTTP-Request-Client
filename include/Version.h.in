//
//  Version.h
//  HTTP
//
//  API version information for libhttpclient.
//

#ifndef HttpClient_Version_h
#define HttpClient_Version_h

#ifdef __cplusplus
extern "C" {
#endif

/** Library version components (injected by CMake at configure time). */
#define HTTPCLIENT_VERSION_MAJOR @HTTPCLIENT_VERSION_MAJOR@
#define HTTPCLIENT_VERSION_MINOR @HTTPCLIENT_VERSION_MINOR@
#define HTTPCLIENT_VERSION_PATCH @HTTPCLIENT_VERSION_PATCH@

/** Full version string, e.g. "1.0.0" */
#define HTTPCLIENT_VERSION_STRING "@HTTPCLIENT_VERSION_MAJOR@.@HTTPCLIENT_VERSION_MINOR@.@HTTPCLIENT_VERSION_PATCH@"

/**
 * Returns the library version as a static string "MAJOR.MINOR.PATCH".
 * The returned pointer is valid for the lifetime of the process.
 */
const char* httpclient_version(void);

/**
 * Returns the major version number (ABI / soname version).
 */
int httpclient_version_major(void);

/**
 * Returns the minor version number.
 */
int httpclient_version_minor(void);

/**
 * Returns the patch version number.
 */
int httpclient_version_patch(void);

#ifdef __cplusplus
}
#endif

#endif /* HttpClient_Version_h */
