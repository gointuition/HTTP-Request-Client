//
//  Version.h
//  HTTP2
//
//  API version information for libhttp2client.
//

#ifndef Http2Client_Version_h
#define Http2Client_Version_h

#ifdef __cplusplus
extern "C" {
#endif

/** Library version components (injected by CMake at configure time). */
#define HTTP2CLIENT_VERSION_MAJOR @HTTP2CLIENT_VERSION_MAJOR@
#define HTTP2CLIENT_VERSION_MINOR @HTTP2CLIENT_VERSION_MINOR@
#define HTTP2CLIENT_VERSION_PATCH @HTTP2CLIENT_VERSION_PATCH@

/** Full version string, e.g. "1.0.0" */
#define HTTP2CLIENT_VERSION_STRING "@HTTP2CLIENT_VERSION_MAJOR@.@HTTP2CLIENT_VERSION_MINOR@.@HTTP2CLIENT_VERSION_PATCH@"

/**
 * Returns the library version as a static string "MAJOR.MINOR.PATCH".
 * The returned pointer is valid for the lifetime of the process.
 */
const char* http2client_version(void);

/**
 * Returns the major version number (ABI / soname version).
 */
int http2client_version_major(void);

/**
 * Returns the minor version number.
 */
int http2client_version_minor(void);

/**
 * Returns the patch version number.
 */
int http2client_version_patch(void);

#ifdef __cplusplus
}
#endif

#endif /* Http2Client_Version_h */
